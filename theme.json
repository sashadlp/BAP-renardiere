{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "700px",
      "wideSize": "1100px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Primaire",
          "color": "#1e3a8a"
        },
        {
          "slug": "secondary",
          "name": "Secondaire",
          "color": "#f59e0b"
        },
        {
          "slug": "dark",
          "name": "Sombre",
          "color": "#111827"
        },
        {
          "slug": "light",
          "name": "Clair",
          "color": "#f9fafb"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.5rem"
        },
        {
          "slug": "medium",
          "name": "Moyen",
          "size": "1.5rem"
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "4rem"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "silkscreen",
          "name": "Silkscreen",
          "fontFamily": "\"Silkscreen\", monospace",
          "fontFace": [
            {
              "fontFamily": "Silkscreen",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/Silkscreen-Regular.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.9rem"
        },
        {
          "slug": "medium",
          "name": "Moyen",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "2rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--light)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--silkscreen)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--silkscreen)",
          "fontWeight": "400"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ]
}